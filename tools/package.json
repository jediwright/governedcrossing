{
  "name": "governedcrossing-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Produces, checks and publishes governed crossing records for the org.governedcrossing.temp lexicons.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cross": "node --import tsx --import ./proto-resolve.mjs 1-cross.mjs",
    "sign": "node 2-project-sign.mjs",
    "check": "node 3-check.mjs",
    "publish-records": "node 4-publish.mjs",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "@atproto/lexicon": "^0.7.14",
    "@ipld/dag-cbor": "^9.2.5",
    "@noble/curves": "^1.9.7",
    "multiformats": "^13.4.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
